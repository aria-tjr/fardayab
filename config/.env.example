# Copy this file to config/.env and fill in values.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
ADMIN_USER_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_LIGHT=gpt-4o-mini
ENABLE_MODERATION=0
STRUCTURED_GENERATION=1

# External APIs (optional but recommended)
NEWSAPI_KEY=
NEWSDATA_KEY=
MEDIASTACK_KEY=
THESPORTSDB_KEY=1
API_FOOTBALL_KEY=
API_SPORTS_KEY=

# Scheduling
TIMEZONE=Asia/Tehran
DAILY_RUN_AT=22:00
# Comma-separated times overrides DAILY_RUN_AT
DAILY_RUN_TIMES=
AUTO_SCHEDULE=1
AUTO_BOOTSTRAP_DAYS=7
AUTO_BOOTSTRAP_TIMES=10:00,13:00,16:00,21:00
AUTO_REGULAR_TIMES=11:00,16:00,21:00

# Features
ENABLE_CHARTS=1
ENABLE_POLL=1
ENABLE_IMAGES=1
IMAGE_SIZE=1024x1024
POST_MODE=split
TOPIC_SEQUENCE=economy,sports,trends,insight
DETAIL_LEVEL=high
TRENDS_COMPARE_REGION=united_states

# Content footer
INCLUDE_DISCLAIMER=1
DISCLAIMER_TEXT=⚠️ این مطلب صرفاً اطلاع‌رسانی است و توصیه مالی نیست.

# Sources footer
INCLUDE_SOURCES=1
SOURCES_COUNT=3

# Persona and tone
TONE=engaging
PERSONA=Persian social media analyst

# Channel control
PIN_POSTS=1

# Intelligent scheduling
DYNAMIC_SCHEDULING=1

# General
ENV=dev
LOG_LEVEL=INFO
HTTP_TIMEOUT=15.0
DB_PATH=data/bot.db
NEWS_LANGUAGE=fa
AB_SEED=tg-content-factory
THESPORTSDB_LEAGUE_IDS=4328,4335
API_SPORTS_LEAGUE_IDS=39,140
