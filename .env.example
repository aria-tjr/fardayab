# =============================================================================
# CRYPTO SIGNAL BOT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# TELEGRAM CONFIGURATION (REQUIRED)
# =============================================================================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram channel ID (use @userinfobot to get channel ID)
# For private channels, use format: -100XXXXXXXXXX
TELEGRAM_CHANNEL_ID=

# =============================================================================
# OPENAI CONFIGURATION (REQUIRED)
# =============================================================================
# Get API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# =============================================================================
# EXCHANGE CONFIGURATION (OPTIONAL)
# =============================================================================
# Exchange to use for market data (default: binance)
EXCHANGE_NAME=binance

# API credentials (optional - only needed for advanced features)
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# =============================================================================
# DATABASE CONFIGURATION (OPTIONAL)
# =============================================================================
# Database URL (default: SQLite file)
DATABASE_URL=
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For MySQL: mysql://user:password@localhost/dbname

# =============================================================================
# CONTENT CONFIGURATION (OPTIONAL)
# =============================================================================
# Default language for content generation (fa=Persian, en=English)
DEFAULT_LANGUAGE=fa

# Content tone (professional, friendly, casual)
CONTENT_TONE=professional

# =============================================================================
# SIGNAL GENERATION PARAMETERS (OPTIONAL)
# =============================================================================
# Minimum volume in USD for trading pairs (default: 5M)
MIN_VOLUME_USD=5000000

# RSI thresholds for trend strategy (OPTIMIZED from backtest results)
TREND_RSI_LONG_MIN=50
TREND_RSI_SHORT_MAX=50

# General RSI thresholds for mean reversion (OPTIMIZED)
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65

# Confidence threshold for signal generation (OPTIMIZED for high frequency)
CONFIDENCE_THRESHOLD=0.55

# =============================================================================
# RISK MANAGEMENT (OPTIONAL)
# =============================================================================
# Position size as percentage of portfolio (default: 5%)
POSITION_SIZE=0.05

# Maximum drawdown percentage (default: 3%)
MAX_DRAWDOWN_PCT=3.0

# Maximum concurrent trades (default: 2)
MAX_CONCURRENT_TRADES=2

# Stop loss and take profit ATR multipliers
STOP_LOSS_ATR_MULTIPLIER=1.2
TAKE_PROFIT_ATR_MULTIPLIER=2.4

# =============================================================================
# SCHEDULING CONFIGURATION (OPTIONAL)
# =============================================================================
# Signal check interval in seconds (default: 300 = 5 minutes)
SIGNAL_CHECK_INTERVAL=300

# Daily content posting times (24-hour format)
MARKET_SUMMARY_TIME=09:00
ALTCOIN_SPOTLIGHT_TIME=13:00
EDUCATION_TIME=19:00

# Weekly report (day: 0=Monday, 4=Friday)
WEEKLY_REPORT_DAY=4
WEEKLY_REPORT_TIME=17:00

# =============================================================================
# ADVANCED FILTERING (OPTIONAL)
# =============================================================================
# Volume and ATR filters
MIN_VOLUME_RATIO=1.5
MIN_ATR_RATIO=1.2

# Trading hours (24-hour format)
TRADING_HOURS_START=8
TRADING_HOURS_END=22

# Minimum trend strength (ADX)
MIN_TREND_STRENGTH=25

# Daily signal targets
MIN_DAILY_SIGNALS=2
MAX_DAILY_SIGNALS=5

# =============================================================================
# ULTRA HIGH WIN RATE MODE (OPTIONAL)
# =============================================================================
# Enable ultra-conservative signal generation
ULTRA_HIGH_WINRATE_MODE=false

# Ultra high confidence threshold (0.0-1.0)
ULTRA_MIN_CONFIDENCE=0.90

# =============================================================================
# SYMBOL CORRELATION (OPTIONAL)
# =============================================================================
# Maximum correlation between symbols for diversification
SYMBOL_CORRELATION_THRESHOLD=0.4