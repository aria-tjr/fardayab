# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel_or_numeric_id
ADMIN_USER_ID=123456789

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# APIs (optional)
NEWSAPI_KEY=
OPENWEATHER_KEY=
THESPORTSDB_KEY=1
API_FOOTBALL_KEY=

# Scheduling
TIMEZONE=Asia/Tehran
DAILY_RUN_AT=22:00
# Optional: multiple times (comma-separated). If set, overrides DAILY_RUN_AT
DAILY_RUN_TIMES=

# General
ENV=dev
LOG_LEVEL=INFO
HTTP_TIMEOUT=15
DB_PATH=data/bot.db

# Content
DEFAULT_CITIES=Tehran, Munich
NEWS_LANGUAGE=fa

# A/B testing
AB_SEED=tg-content-factory

# Sports
THESPORTSDB_LEAGUE_IDS=4328,4335

# Features
ENABLE_CHARTS=1
ENABLE_POLL=1
TRENDS_COMPARE_REGION=united_states

# Posting mode (split posts per topic)
POST_MODE=split
TOPIC_SEQUENCE=economy,sports,trends,weather,insight
DETAIL_LEVEL=high
ENABLE_IMAGES=1
IMAGE_SIZE=1024x1024

# Auto-schedule
AUTO_SCHEDULE=1
AUTO_BOOTSTRAP_DAYS=7
AUTO_BOOTSTRAP_TIMES=10:00,13:00,16:00,21:00
AUTO_REGULAR_TIMES=11:00,16:00,21:00
