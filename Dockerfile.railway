# Railway-optimized Dockerfile for Crypto Signal Bot
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY run_bot.py .
COPY start.py .
COPY railway_main.py .
COPY railway_start_simple.py .
COPY railway_bot.py .
COPY railway_start_final.py .

# Ensure all directories have __init__.py files
RUN find ./src -type d -exec touch {}/__init__.py \;

# Set Python path for Railway
ENV PYTHONPATH=/app:/app/src
ENV PYTHONUNBUFFERED=1

# Create non-root user
RUN useradd -m -u 1000 botuser && \
    chown -R botuser:botuser /app
USER botuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.path.insert(0, '/app'); from src.config import Config; Config.validate()" || exit 1

# Start command
CMD ["python", "-m", "src.main"]
